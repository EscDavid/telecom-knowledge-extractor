   "context": "huawei(config-if-opg-0/<slot>)#"
  },
  "interfaz_meth": {
   "cmd": "display interface meth 0",
   "notes": ["meth0 = interfaz de gestión fuera de banda"]
  },
  "interfaz_vlanif": {
   "cmd": "display interface vlanif <id>"
  },
  "listar_line_profiles": {
   "cmd": "display ont-lineprofile gpon {all|bound-info|profile-id|profile-name}",
   "example": "display ont-lineprofile gpon all",
   "columns": ["Profile-ID", "Profile-name", "Binding times"]
  },
  "ver_line_profile": {
   "cmd": "display ont-lineprofile gpon profile-id <id>",
   "fields_observed": ["Profile-ID", "Profile-name", "Access-type", "FEC upstream switch", "OMCC encrypt switch", "Qos mode", "Mapping mode", "TR069 management", "TR069 IP index", "Bundle-ID/Port-list", "T-CONT <n> DBA Profile-ID"]
  },
  "listar_service_profiles": {
   "cmd": "display ont-srvprofile gpon {all|bound-info|profile-id|profile-name}",
   "columns": ["Profile-ID", "Profile-name", "Binding times"]
  },
  "ver_service_profile": {
   "cmd": "display ont-srvprofile gpon profile-id <id>",
   "fields_observed": ["Port-type/Port-number (POTS, ETH, VDSL, TDM, MOCA, CATV)", "TDM port type", "TDM service type", "MAC learning function switch", "ONT transparent function switch", "Multicast forward mode/VLAN", "Native VLAN option"]
  },
  "listar_dba_profiles": {
   "cmd": "display dba-profile all",
   "context": "huawei(config-if-gpon-0/<slot>)# o global",
   "columns": ["Profile-ID", "type", "Bandwidth compensation", "Fix(kbps)", "Assure(kbps)", "Max(kbps)", "Bind times"]
  },
  "ver_dba_profile": {
   "cmd": "display dba-profile profile-id <id>",
   "fields_observed": ["Profile-name", "Profile-ID", "type", "Bandwidth compensation", "Fix-delay", "Fix(kbps)", "Assure(kbps)", "Max(kbps)", "Additional-bandwidth", "Best-effort-priority", "Best-effort-weight", "bind-times"]
  },
  "tabla_ruteo_multicast": {
   "cmd": "display multicast routing-table",
   "fields_observed": ["grupo/origen", "Uptime", "Upstream Interface", "downstream interfaces"]
  },
  "estadisticas_flujo_multicast": {
   "cmd": "display multicast flow-statistic {vlan <id>|...} {ip|ipv6} <addr> [sourceip]"
  },
  "tabla_forwarding_multicast": {
   "cmd": "display multicast forwarding-table <F>/<S>/<P> ont <ont-id> [eth|verbose]",
   "fields_observed": ["Group addr", "Source IP", "VLAN", "ONT-port", "Client IP", "Age(second)"],
   "notes": ["'SSID' en ONT-port indica el SSID WiFi usado"]
