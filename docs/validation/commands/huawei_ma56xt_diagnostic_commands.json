 "commands": {
  "ver_ont_detallada": {
   "cmd": "display ont info {by-desc|by-ip|by-loid|by-mac|by-password|by-sn|<frame>} <slot> <port> <ont-id>",
   "example": "display ont info 0 3 0 0",
   "fields_observed": ["F/S/P", "ONT-ID", "Control flag", "Run state", "Config state", "Match state", "ONT LLID", "ONT distance(m)", "ONT RTT(TQ)", "Memory occupation", "CPU occupation", "Temperature", "Authentic type", "Discovery mode", "Discovery state", "MAC", "Password", "Management mode"]
  },
  "trafico_puerta_pon": {
   "cmd": "display port traffic <port>",
   "context": "huawei(config-if-gpon-0/<slot>)#",
   "example": "display port traffic 0",
   "fields_observed": ["Up traffic (kbps)", "Down traffic (kbps)"]
  },
  "config_puerta_pon": {
   "cmd": "display port info <port>",
   "context": "huawei(config-if-gpon-0/<slot>)#",
   "fields_observed": ["F/S/P", "Min distance(km)", "Max distance(km)", "Left guaranteed bandwidth(kbps)", "Number of T-CONTs", "Autofind", "FEC check", "Admin State", "ONT encryption key switching interval(m)", "PON-ID switch", "PON-ID identifier", "Jumbo frame switch", "Surplus bandwidth assignment", "Best-effort bandwidth assignment"]
  },
  "estado_optico_puerta_pon": {
   "cmd": "display port state <port>",
   "context": "huawei(config-if-gpon-0/<slot>)#",
   "fields_observed": ["Port state", "Last down cause", "Last up time", "Last down time", "Port energy-saving flag", "xPON MAC chipset state", "Signal detect", "Available bandwidth(Kbps)", "Illegal rogue ONT", "Optical Module status", "Laser state", "TX fault", "Temperature(C)", "TX Bias current(mA)", "Supply Voltage(V)", "TX power(dBm)"]
  },
  "estadisticas_puerta_pon": {
   "cmd": "display statistics port ethernet <port>",
   "context": "huawei(config-if-gpon-0/<slot>)#",
   "fields_observed": ["Received/Sent frames, bytes, unicast/multicast/broadcast, por rango de tamaño, CRC error frames, discarded frames, error frames"]
  },
  "ver_service_port": {
   "cmd": "display service-port {all|autosense|board|connect-oriented|desc|index <n>|number|port|vlan}",
   "example": "display service-port 100",
   "fields_observed": ["Index", "VLAN ID", "VLAN attr", "Port type", "F/S/P", "VPI/VCI", "Admin status", "State", "PVC bundle", "Channel", "Max MAC count", "Tag transform", "Description", "Static MAC", "IP address"]
  },
  "trafico_service_port": {
   "cmd": "display traffic service-port <index>",
   "fields_observed": ["Service-port", "Upstream(Kbps)", "Downstream(Kbps)"]
  },
  "estadisticas_service_port": {
   "cmd": "display statistics service-port [<index>]",
   "fields_observed": ["Number of upstream/downstream bytes, packets, discard packets"]
  },
  "trafico_puerta_eth": {
   "cmd": "display port traffic <port>",
   "context": "huawei(config-if-eth-0/<slot>)#",
   "fields_observed": ["received/transmitted traffic en packets/s, octets/s, kbits/s"]
  },
  "estadisticas_puerta_eth": {
   "cmd": "display port statistics <port>",
   "context": "huawei(config-if-eth-0/<slot>)#"
  },
  "estado_puerta_eth": {
   "cmd": "display port state {all|<port>}",
   "context": "huawei(config-if-giu-0/<slot>)#",
   "notes": ["giu = interfaz uplink eléctrica, distinto de eth/gpon"]
  },
  "estado_modulo_optico_eth": {
