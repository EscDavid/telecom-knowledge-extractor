     "note": null
    },
    {
     "cmd": "pon-onu-mng gpon_onu-<pon>:<N>",
     "rollback": null,
     "note": null
    },
    {
     "cmd": "reboot",
     "rollback": null,
     "note": null
    },
    {
     "cmd": "yes",
     "rollback": null,
     "note": null
    },
    {
     "cmd": "end",
     "rollback": null,
     "note": null
    }
   ],
   "expected": "corte de ~45-55 s; working -> LOS -> syncMib -> working",
   "notes": [
    "el 'no' cancela",
    "impacta al cliente: confirmar en la UI"
   ]
  },
  "guardar_configuracion": {
   "desc": "Persistir la configuración en el arranque.",
   "steps": [
