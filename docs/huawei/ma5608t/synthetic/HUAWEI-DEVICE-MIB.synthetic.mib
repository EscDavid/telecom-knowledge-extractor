hwAvgDuty5min OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  unknown
    STATUS      current
    DESCRIPTION
        "The value of this object identifies the average CPU usage of a board or entity 5 minutes before the data is read."
    ::= { 1 3 6 1 4 1 2011 6 3 4 1 4 }

hwCpuRunTime OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  unknown
