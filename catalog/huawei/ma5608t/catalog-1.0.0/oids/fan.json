    {
      "id": "oid.huawei.gpon.fan.frame_fan_alarm",
      "oid": "1.3.6.1.4.1.2011.6.3.3.1.1.21",
      "name": "hwFrameFanAlarm",
      "mib_table": null,
      "index": {
        "type": "simple",
        "bit_calculation": false,
        "components": null
      },
      "syntax": "Bits",
      "unit": null,
      "scale": null,
      "access": "unknown",
      "enumeration": null,
      "description": "This MIB node is used to query the alarm status of the fan in the extended frame, which is represented by bits.\nFunctions of each bit are as follows:\n1: faSupportQuery(0) - indicates whether query of the alarm status of the fan in the extended frame is supported.\nIf this bit is 0, the query is supported. If this bit is 1, the query is not supported. When the extended frame\nis normal and reports the fan alarm status to the main frame, the query is supported. In other cases, the query is not supported.\n2: faFanState(1) - indicates the communication status of the fan in the extended frame. If this bit is 0, the communication is normal.\nIf this bit is 1, the communication is abnormal. If the communication is abnormal, the value of faFanBlockState(2) and faFansBlockState(3) are invalid,\nuser do not have to pay attention to them.\n3: faFanBlockState(2) - indicates whether a single fan in the extended frame is blocked. If this bit is 0, no single fan is blocked.\nIf this bit is 1, a single fan is blocked.\n4: faFansBlockState(3) - indicates whether multiple fans in the extended frame are blocked. If this bit is 0, no multiple fans are blocked.\nIf this bit is 1, multiple fans are blocked.",
      "command_ref": null,
      "status": "documented",
      "sources": [
        {
          "doc_type": "mib_file",
          "pages": null,
          "confidence": 0.3
        }
      ],
