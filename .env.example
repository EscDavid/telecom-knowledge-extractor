# Plantilla de credenciales del Loader. Copia a `.env` (en la RAIZ del repo,
# junto a main.py) y completa. El `.env` esta en .gitignore — NO se versiona.
#
#   cp .env.example .env   &&   editar .env
#
# Password del USUARIO MySQL del loader (tkc_loader) — para conectarse a la instancia.
# (El nombre de la variable lo define config/pipeline.yaml -> database.password_env)
TKC_DB_PASSWORD=

# OJO: el password del SUPERADMIN (humano, validado con bcrypt contra db_auth.users)
# NO va aqui: se pide oculto por prompt al correr `load`, o via --password-env OTRA_VAR.

# --- Walk collector (py -m src.walk_collector) — SNMPv2c de SOLO LECTURA -------------
# Host/puerto/community de la OLT a recolectar. Los NOMBRES de estas variables los
# define config/pipeline.yaml -> walk_collector.snmp.*_env. Si TKC_SNMP_COMMUNITY queda
# vacía, se pide oculta por prompt. La community NUNCA se imprime ni se guarda
# (logs, estado y reportes la enmascaran como ***).
TKC_SNMP_HOST=
TKC_SNMP_PORT=
TKC_SNMP_COMMUNITY=

# =============================================================================
# Credenciales de OLT POR MARCA (las lee src/creds.py; los valores NUNCA se imprimen)
#   TKC_<MARCA>_<CLAVE>             una por marca
#   TKC_<MARCA>_<MODELO>_<CLAVE>    override opcional por equipo (p. ej. TKC_ZTE_C600_RO_COMMUNITY)
# Precedencia: modelo → marca → variables antiguas (TKC_SNMP_*/TKC_TELNET_*, solo ZTE).
# Una variable vacía se ignora. Ver: python3 scripts/vendor_identify.py <MARCA> --dry-run
# =============================================================================

# --- ZTE ---
TKC_ZTE_HOST=
TKC_ZTE_SNMP_PORT=
TKC_ZTE_RO_COMMUNITY=
TKC_ZTE_RW_COMMUNITY=
TKC_ZTE_SNMPV3_USER=
TKC_ZTE_SNMPV3_AUTH_PROTO=
TKC_ZTE_SNMPV3_AUTH_PASSWORD=
TKC_ZTE_SNMPV3_PRIV_PROTO=
TKC_ZTE_SNMPV3_PRIV_PASSWORD=
TKC_ZTE_CLI_PROTO=
TKC_ZTE_CLI_PORT=
TKC_ZTE_CLI_USER=
TKC_ZTE_CLI_PASSWORD=

# --- HUAWEI ---
TKC_HUAWEI_HOST=
TKC_HUAWEI_SNMP_PORT=
TKC_HUAWEI_RO_COMMUNITY=
TKC_HUAWEI_RW_COMMUNITY=
TKC_HUAWEI_SNMPV3_USER=
TKC_HUAWEI_SNMPV3_AUTH_PROTO=
TKC_HUAWEI_SNMPV3_AUTH_PASSWORD=
TKC_HUAWEI_SNMPV3_PRIV_PROTO=
TKC_HUAWEI_SNMPV3_PRIV_PASSWORD=
TKC_HUAWEI_CLI_PROTO=
TKC_HUAWEI_CLI_PORT=
TKC_HUAWEI_CLI_USER=
TKC_HUAWEI_CLI_PASSWORD=

# --- VSOL ---
TKC_VSOL_HOST=
TKC_VSOL_SNMP_PORT=
TKC_VSOL_RO_COMMUNITY=
TKC_VSOL_RW_COMMUNITY=
TKC_VSOL_SNMPV3_USER=
TKC_VSOL_SNMPV3_AUTH_PROTO=
TKC_VSOL_SNMPV3_AUTH_PASSWORD=
TKC_VSOL_SNMPV3_PRIV_PROTO=
TKC_VSOL_SNMPV3_PRIV_PASSWORD=
TKC_VSOL_CLI_PROTO=
TKC_VSOL_CLI_PORT=
TKC_VSOL_CLI_USER=
TKC_VSOL_CLI_PASSWORD=
